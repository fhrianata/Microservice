# =============================================================================
# Konfigurasi environment untuk docker-compose.yml
# =============================================================================
# File ini berisi kredensial DEVELOPMENT/LOKAL saja (biar `docker compose up`
# langsung jalan tanpa setup tambahan). Untuk penggunaan di luar laptop
# sendiri (server, production, dsb), GANTI semua password di bawah dan
# JANGAN commit file .env berisi kredensial asli ke git (tambahkan ke
# .gitignore).
# =============================================================================

# --- MySQL (dipakai authservice) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=auth_db

# --- RabbitMQ (dipakai order, produser, consumer) ---
RABBITMQ_USER=ari
RABBITMQ_PASSWORD=12345

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- SMTP untuk email notifikasi order (dipakai consumer) ---
# PENTING: sebelumnya ada kredensial Gmail (username + app-password) yang
# ter-hardcode langsung di source code (consumer/application.properties).
# Kredensial itu SUDAH BOCOR karena ikut ter-upload -- kalau itu app password
# Gmail yang masih aktif, SEGERA cabut/hapus dari
# https://myaccount.google.com/apppasswords, lalu buat yang baru dan isikan
# di bawah ini. Kalau dikosongkan, service consumer tetap jalan normal,
# cuma pengiriman email notifikasi akan gagal (tercatat di log & di metrik
# Grafana "Email Terkirim" akan diam di 0) -- ini tidak mengganggu bagian
# lain dari sistem.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_TO=fachrianata123@gmail.com
